# -----------------------------------------------------------------------------
# ExcelUp AI Environment Variables
# -----------------------------------------------------------------------------
# NOTE: NO .env file is required to run the application locally or on Vercel!
# The app is fully self-contained with built-in Next.js serverless route handlers
# and in-memory seed data.
# -----------------------------------------------------------------------------

# (Optional) Leave empty to use local Next.js API routes (recommended for Vercel):
NEXT_PUBLIC_API_URL=

# (Optional) AI Keys if you wish to connect LLM features later:
GEMINI_API_KEY=
GROQ_API_KEY=

# (Optional) External PostgreSQL/Neon connection string if you wish to connect a database:
DATABASE_URL=
SECRET_KEY=
